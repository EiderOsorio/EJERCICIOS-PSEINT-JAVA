Algoritmo Ejercicio8
		Definir millas, metros Como Real
		
		Escribir "8. Ingrese la distancia en millas marinas:"
		Leer millas
		
		// Sabendo que 1 milla marina equivale a 1852 metros
		metros <- millas * 1852
		
		Escribir "----------------------------------------"
		Escribir millas, " millas marinas equivalen a ", metros, " metros."
		Escribir "----------------------------------------"
		
FinAlgoritmo
