Algoritmo ejercicio17
	definir lado1, lado2, perimetro, area Como Real
	Escribir "Digite el primer lado"
	leer lado1
	Escribir "Digite el segundo lado"
	leer lado2
	perimetro= (2 * lado1) + (2 * lado2)
	area= lado1 * lado2
	
	escribir "su perimetro es: " perimetro
	escribir "su area es: " area
	
	
FinAlgoritmo
