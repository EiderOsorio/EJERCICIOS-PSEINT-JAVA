Algoritmo Ejercicio7
		Definir fahrenheit, celsius Como Real
		
		Escribir "7. Ingrese la temperatura en grados Fahrenheit:"
		Leer fahrenheit
		
		// Fórmula de conversión: (Fahrenheit - 32) * 5 / 9
		celsius <- (fahrenheit - 32) * 5 / 9
		
		Escribir "El equivalente en grados Celsius es: ", celsius, " °C"
		
FinProceso