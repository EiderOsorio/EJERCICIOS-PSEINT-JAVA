Algoritmo Ejercicio6
		Definir fahrenheit, celsius Como Real
		
		Escribir "=== CONVERSOR DE FAHRENHEIT A CELSIUS ==="
		Escribir "Ingrese la temperatura en grados Fahrenheit:"
		Leer fahrenheit
		
		// Aplicamos la fórmula de conversión
		celsius <- (fahrenheit - 32) * 5 / 9
		
		Escribir "----------------------------------------"
		Escribir fahrenheit, " °F equivalen a ", celsius, " °C"
		Escribir "----------------------------------------"
		
FinProceso