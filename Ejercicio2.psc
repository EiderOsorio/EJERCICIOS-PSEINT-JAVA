Algoritmo Ejercicio2
		Definir salario_total, horas_trabajadas, valor_hora Como Real
		
		// Entrada de datos (pueden ser ingresados por teclado o asignados directamente)
		salario_total <- 1056028
		horas_trabajadas <- 36
		
		// Proceso: Despejamos el valor de la hora dividiendo el salario total entre las horas
		valor_hora <- salario_total / horas_trabajadas
		
		// Salida de resultados
		Escribir "----------------------------------------"
		Escribir "       CÁLCULO DEL VALOR DE LA HORA     "
		Escribir "----------------------------------------"
		Escribir "Salario Total Mensual: $", salario_total
		Escribir "Horas Trabajadas: ", horas_trabajadas
		Escribir "Valor de cada hora: $", valor_hora
		Escribir "----------------------------------------"
		
FinAlgoritmo
FinAlgoritmo
