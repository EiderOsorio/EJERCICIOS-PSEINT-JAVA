Algoritmo Ejercicio10
	Definir precio, precio_con_iva, iva Como real
	definir  Articulo Como Caracter
	Escribir "Digite el nombre de su articulo: "
	leer Articulo
	Escribir "Digite el precio de su articulo: "
	leer precio
	//usaré de ejemplo un porcentaje de iva del 19%
	precio_con_iva = Precio + (precio * 0.19)
	iva = precio * 0.19
	escribir "Su total a pagar es (+iva): "
	escribir precio_con_iva
	escribir "total de impuesto añadido: (19%)"
	escribir iva
	
	
FinAlgoritmo
